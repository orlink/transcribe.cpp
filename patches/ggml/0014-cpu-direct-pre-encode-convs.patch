+// b [C] f32, then ReLU: [OW, OH, C, 1]. Reproduces ggml_conv_2d (f16 im2col and matmul) + ggml_add + ggml_relu.
+ggml_custom_op_t ggml_cpu_conv_2d_s2_c1_bias_relu_op(const struct ggml_tensor * x, const struct ggml_tensor * w,
