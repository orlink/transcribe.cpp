@@ -0,0 +1,554 @@
+#if defined(__GNUC__)
+#pragma GCC diagnostic ignored "-Wpedantic"
+#endif
+
+#include "mmq-grouped.h"
+#include "amx.h"
+#include "ggml-impl.h"
