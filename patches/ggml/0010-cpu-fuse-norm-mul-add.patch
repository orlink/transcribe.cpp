diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
index cbd703d..5c72ff5 100644
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -3111,6 +3111,26 @@ static int ggml_cpu_try_fuse_ops(
 
     struct ggml_tensor * node = cgraph->nodes[node_n];
 
+    if (node->op == GGML_OP_NORM) {
+        // NORM + MUL + ADD (layer norm with weight and bias)
+        const enum ggml_op fuse_ops[] = { GGML_OP_NORM, GGML_OP_MUL, GGML_OP_ADD };
+        if (ggml_can_fuse(cgraph, node_n, fuse_ops, 3)) {
+            struct ggml_tensor * mul_node = cgraph->nodes[node_n + 1];
+            struct ggml_tensor * add_node = cgraph->nodes[node_n + 2];
+            const struct ggml_tensor * w = (mul_node->src[0] == node) ? mul_node->src[1] : mul_node->src[0];
+            const struct ggml_tensor * b = (add_node->src[0] == mul_node) ? add_node->src[1] : add_node->src[0];
+            if (node->src[0]->type == GGML_TYPE_F32 && node->src[0]->nb[0] == sizeof(float) &&
+                mul_node->type == GGML_TYPE_F32 && add_node->type == GGML_TYPE_F32 &&
+                add_node->nb[0] == sizeof(float) &&
+                w->type == GGML_TYPE_F32 && ggml_nrows(w) == 1 && w->ne[0] == node->ne[0] && w->nb[0] == sizeof(float) &&
+                b->type == GGML_TYPE_F32 && ggml_nrows(b) == 1 && b->ne[0] == node->ne[0] && b->nb[0] == sizeof(float)) {
+
+                ggml_compute_forward_norm_mul_add_fused(params, node, mul_node, add_node);
+                return 2;
+            }
+        }
+    }
+
     if (node->op == GGML_OP_RMS_NORM) {
         // RMS_NORM + MUL fusion
         const enum ggml_op fuse_ops[] = { GGML_OP_RMS_NORM, GGML_OP_MUL };
diff --git a/src/ggml-cpu/ops.cpp b/src/ggml-cpu/ops.cpp
index 7d8cffa..d25f3a9 100644
--- a/src/ggml-cpu/ops.cpp
+++ b/src/ggml-cpu/ops.cpp
@@ -4076,6 +4076,58 @@ static void ggml_compute_forward_norm_f32(
     }
 }
 
+// NORM -> MUL(w) -> ADD(b) on f32 rows, with w and b a single row each. Each row is normalized as in
+// ggml_compute_forward_norm_f32, then scaled and shifted by the separate loops the MUL and ADD nodes
+// would run, so every element is rounded after every operation as before.
+void ggml_compute_forward_norm_mul_add_fused(
+        const ggml_compute_params * params,
+        ggml_tensor * dst_norm,
+        ggml_tensor * dst_mul,
+        ggml_tensor * dst_add) {
+
+    const ggml_tensor * src0 = dst_norm->src[0];
+    const ggml_tensor * w    = dst_mul->src[0] == dst_norm ? dst_mul->src[1] : dst_mul->src[0];
+    const ggml_tensor * b    = dst_add->src[0] == dst_mul  ? dst_add->src[1] : dst_add->src[0];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && dst_add->type == GGML_TYPE_F32);
+    GGML_ASSERT(src0->nb[0] == sizeof(float) && dst_add->nb[0] == sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t ne00 = src0->ne[0];
+    const int64_t ne01 = src0->ne[1];
+    const int64_t ne02 = src0->ne[2];
+    const int64_t ne03 = src0->ne[3];
+
+    const float * wf = (const float *) w->data;
+    const float * bf = (const float *) b->data;
+
+    float eps;
+    memcpy(&eps, dst_norm->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    for (int64_t i03 = 0; i03 < ne03; i03++) {
+        for (int64_t i02 = 0; i02 < ne02; i02++) {
+            for (int64_t i01 = ith; i01 < ne01; i01 += nth) {
+                const float * xf = (const float *) ((const char *) src0->data + i01*src0->nb[1] + i02*src0->nb[2] + i03*src0->nb[3]);
+                float       * yf = (float *) ((char *) dst_add->data + i01*dst_add->nb[1] + i02*dst_add->nb[2] + i03*dst_add->nb[3]);
+
+                float sum = 0.0;
+                ggml_vec_sum_f32(ne00, &sum, xf);
+                const float mean = sum/ne00;
+
+                const float variance = ggml_vec_cvar_f32(ne00, yf, xf, mean);
+                const float scale    = 1.0f/sqrtf(variance + eps);
+                ggml_vec_scale_f32(ne00, yf, scale);
+
+                ggml_vec_mul_f32(ne00, yf, yf, wf);
+                ggml_vec_add_f32(ne00, yf, yf, bf);
+            }
+        }
+    }
+}
+
 void ggml_compute_forward_norm(
         const ggml_compute_params * params,
         ggml_tensor * dst) {
